GUARDRAIL_APP_NAME=Guardrail Mini
GUARDRAIL_ENVIRONMENT=development
GUARDRAIL_HOST=127.0.0.1
GUARDRAIL_PORT=8000
GUARDRAIL_LOG_LEVEL=INFO
# Set this when using the PostgreSQL control plane (required for Alembic migrations).
# GUARDRAIL_DATABASE_URL=postgresql+psycopg://guardrail:guardrail_dev_only@localhost:5432/guardrail
GUARDRAIL_TOXICITY_THRESHOLD=0.80
GUARDRAIL_TOXICITY_REVIEW_THRESHOLD=0.55
GUARDRAIL_TOXICITY_MODEL_DIR=models/toxicity/v1
GUARDRAIL_PII_THRESHOLD=0.80
GUARDRAIL_PII_REVIEW_THRESHOLD=0.55
GUARDRAIL_PROMPT_INJECTION_THRESHOLD=0.80
GUARDRAIL_PROMPT_INJECTION_REVIEW_THRESHOLD=0.55
GUARDRAIL_PROMPT_INJECTION_MODEL_DIR=models/prompt-injection/v1
GUARDRAIL_MODEL_DEVICE=auto
