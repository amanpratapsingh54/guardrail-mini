GUARDRAIL_APP_NAME=Guardrail Mini
GUARDRAIL_ENVIRONMENT=development
GUARDRAIL_HOST=127.0.0.1
GUARDRAIL_PORT=8000
GUARDRAIL_LOG_LEVEL=INFO
GUARDRAIL_MAX_REQUEST_BODY_BYTES=65536
GUARDRAIL_RATE_LIMIT_REQUESTS_PER_MINUTE=600
GUARDRAIL_API_KEY_CACHE_TTL_SECONDS=30
# Set this when using the PostgreSQL control plane (required for Alembic migrations).
# GUARDRAIL_DATABASE_URL=postgresql+psycopg://guardrail:guardrail_dev_only@localhost:5432/guardrail
# Configure the MinIO endpoint and both credentials together to load registered artifacts.
# GUARDRAIL_MINIO_ENDPOINT_URL=http://127.0.0.1:9000
# GUARDRAIL_MINIO_ACCESS_KEY=replace_with_local_access_key
# GUARDRAIL_MINIO_SECRET_KEY=replace_with_local_secret_key
# GUARDRAIL_MINIO_BUCKET=guardrail-models
# GUARDRAIL_ARTIFACT_CACHE_DIR=data/model-cache
GUARDRAIL_TOXICITY_THRESHOLD=0.80
GUARDRAIL_TOXICITY_REVIEW_THRESHOLD=0.55
GUARDRAIL_TOXICITY_MODEL_DIR=models/toxicity/v1
GUARDRAIL_PII_THRESHOLD=0.80
GUARDRAIL_PII_REVIEW_THRESHOLD=0.55
GUARDRAIL_PROMPT_INJECTION_THRESHOLD=0.80
GUARDRAIL_PROMPT_INJECTION_REVIEW_THRESHOLD=0.55
GUARDRAIL_PROMPT_INJECTION_MODEL_DIR=models/prompt-injection/v1
GUARDRAIL_MODEL_DEVICE=auto
GUARDRAIL_MODEL_RUNTIME=onnxruntime
GUARDRAIL_ONNX_CACHE_DIR=data/onnx-cache

# Docker Compose local development credentials; all service ports bind to loopback.
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail_dev_only
POSTGRES_DB=guardrail
MINIO_ROOT_USER=guardrailminio
MINIO_ROOT_PASSWORD=guardrailminio_dev_only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=guardrail_grafana_dev_only
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
